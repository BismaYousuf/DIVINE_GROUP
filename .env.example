# ----------------------------------------------------------------------------
# Divine Group — environment variables
# Copy to .env.local and fill in. See docs/TECHNICAL.md sections 4 and 9.
# ----------------------------------------------------------------------------

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# FROM address. During testing use the Resend shared domain:
#   "Divine Group Website Team <onboarding@resend.dev>"
# After the real domain is verified, switch to e.g.:
#   "Divine Group Website Team <quotes@send.divinegroupstore.com>"
EMAIL_FROM="Divine Group Website Team <onboarding@resend.dev>"

# Where form submissions are delivered.
QUOTE_INBOX="submissions@divinegroupllc.com"
CONTACT_INBOX="submissions@divinegroupllc.com"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Spam (optional; leave blank to disable Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- File upload strategy (Phase 2 quote form; see docs/TECHNICAL.md section 7) ---
# "attach" -> attach files directly to the email (total < ~25MB)
# "blob"   -> upload to Vercel Blob, email download links
UPLOAD_STRATEGY="attach"
BLOB_READ_WRITE_TOKEN=""
